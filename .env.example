# ============================================================
# Mohit Mundke Portfolio — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ─── GitHub Integration ───────────────────────────────────
# Optional: GitHub personal access token for higher API rate limits
# Without this token: 60 requests/hour (usually sufficient)
# With this token: 5000 requests/hour
# Create at: https://github.com/settings/tokens (read:user scope only)
VITE_GITHUB_TOKEN=

# ─── LinkedIn Integration ─────────────────────────────────
# Set to 'true' only when you have configured the backend LinkedIn API
# Leave as 'false' to use curated fallback posts
VITE_LINKEDIN_API_ENABLED=false

# Backend-only LinkedIn variables (NEVER use VITE_ prefix for secrets):
# These must be set in your Vercel/Netlify environment variables,
# NOT in this .env file (they should never reach the browser).
#
# LINKEDIN_CLIENT_ID=your_client_id_here
# LINKEDIN_CLIENT_SECRET=your_client_secret_here
# LINKEDIN_ACCESS_TOKEN=your_access_token_here
# LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID

# ─── Ask Mohit AI Assistant ───────────────────────────────
# AI provider for the "Ask Mohit" assistant
# Options: 'gemini', 'openai'
# Leave empty to use the local Q&A fallback (no API needed)
VITE_AI_PROVIDER=

# API key for the selected provider
# For Gemini: Create at https://aistudio.google.com/app/apikey
# For OpenAI: Create at https://platform.openai.com/api-keys
VITE_AI_API_KEY=

# Optional: specific model to use
# Gemini default: gemini-1.5-flash
# OpenAI default: gpt-4o-mini
VITE_AI_MODEL=

# ─── Contact Form ─────────────────────────────────────────
# Optional: Backend endpoint for the contact form
# If not set, form shows a success message without sending
# Example: https://formspree.io/f/YOUR_FORM_ID
VITE_CONTACT_ENDPOINT=
